━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Install core
pnpm add @authsome/ui-core @authsome-ui/react

# Install the adapter you need
pnpm add @authsome/adapter-supabase @supabase/supabase-js
# OR
pnpm add @authsome-ui/adapter-clerk @clerk/clerk-js
# OR
pnpm add @authsome-ui/adapter-authsome
# OR
pnpm add @authsome-ui/adapter-generic

# Use it
import { AuthClient } from '@authsome/ui-core';
import { SupabaseAdapter } from '@authsome/adapter-supabase';

const client = new AuthClient({
  provider: new SupabaseAdapter({
    url: process.env.NEXT_PUBLIC_SUPABASE_URL,
    anonKey: process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY,
  }),
});

