{
  "name": "@authsome/ui-react-headless",
  "version": "0.1.4",
  "description": "Unstyled, accessible React components for AuthSome UI",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "authentication",
    "auth",
    "react",
    "headless",
    "components"
  ],
  "author": "Rex Raphael",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xraph/authsome-ui.git",
    "directory": "packages/react-headless"
  },
  "peerDependencies": {
    "@authsome/ui-core": "workspace:*",
    "@authsome/ui-react": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@testing-library/react": "^14.2.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}

