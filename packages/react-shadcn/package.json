{
  "name": "@authsome/ui-react-shadcn",
  "version": "0.1.3",
  "description": "shadcn/ui auth components CLI - add auth components to your project",
  "type": "module",
  "bin": {
    "authsome-ui": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ignore-path ../../.eslintignore",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "execa": "^8.0.1"
  },
  "peerDependencies": {
    "@authsome/ui-core": "workspace:*",
    "@authsome/ui-react": "workspace:*",
    "@authsome/ui-react-headless": "workspace:*"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.16",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "auth",
    "authentication",
    "shadcn",
    "ui",
    "react",
    "cli",
    "components",
    "authsome-ui"
  ],
  "author": "XRAPH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xraph/authsome-ui.git",
    "directory": "packages/react-shadcn"
  }
}
